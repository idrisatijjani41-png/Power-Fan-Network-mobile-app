rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId} {

      // User can only create their own account document.
      // Sensitive/reward fields cannot be supplied by the client.
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny([
          'fanBalance',
          'afamBalance',
          'kycLevel',
          'referralCount'
        ]);

      // User can only read their own account.
      allow read: if isOwner(userId);

      // User can update their own account,
      // but cannot directly modify sensitive fields.
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny([
            'fanBalance',
            'afamBalance',
            'kycLevel',
            'referralCount'
          ]);

      // User cannot delete their account directly.
      allow delete: if false;

      // Transactions
      match /transactions/{txId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Mining sessions
      match /miningSessions/{sessionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Daily tasks
      match /dailyTasks/{taskId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // KYC
      match /kyc/{kycRecord} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }
  }
}
